apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: default-pool
  namespace: {{ metallb_namespace }}
spec:
  addresses:
    - {{ metallb_ip_range }}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: default-l2adv
  namespace: {{ metallb_namespace }}
spec:
  ipAddressPools:
    - default-pool
