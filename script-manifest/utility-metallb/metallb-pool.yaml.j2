# The cluster's single MetalLB address pool, owned by this repo (applied by addon_metallb).
# Names match the pool the observability repo used to create, so nothing that referenced it
# by name changes. App repos request an address from it with metallb.io/loadBalancerIPs;
# they must not create IPAddressPools of their own (an overlapping pool is rejected by
# MetalLB's admission webhook).
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: local-pool
  namespace: {{ metallb_namespace }}
spec:
  addresses:
    - {{ metallb_ip_range }}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: local-l2
  namespace: {{ metallb_namespace }}
spec:
  ipAddressPools:
    - local-pool
  # Announce ONLY on the host-only network the pool belongs to (192.168.56.0/24).
  # Without this, MetalLB answers ARP on every interface, including eth0, the
  # VirtualBox NAT adapter. VirtualBox's NAT engine then keeps "re-guessing" the
  # guest's address from those gratuitous ARPs (VBox.log: "NAT: Guest address guess
  # changed from 10.0.2.15 to 192.168.56.240") and degrades; on 2026-10-31 the
  # control plane's NAT ran out of buffers ("NAT: Can't allocate mbuf"), killing
  # its internet access and `vagrant ssh`. CoreDNS runs there, so cluster DNS
  # failed and ArgoCD could not reach GitHub (sync status Unknown).
  interfaces:
    - {{ metallb_l2_interface }}
